# You can skip this file and paste keys in the Home chat instead.
# They are stored in data/runtime.json (gitignored).

# ── LLM provider: auto | openrouter | xai ─────────────────────
# auto = OPENROUTER_API_KEY if set, else XAI_API_KEY
ASDA_LLM_PROVIDER=openrouter

# OpenRouter (https://openrouter.ai/keys) — one key, any model
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://localhost
OPENROUTER_APP_NAME=ASDA
# Use OpenRouter slugs: provider/model
ASDA_MODEL_FRONTIER=anthropic/claude-sonnet-4
ASDA_MODEL_FAST=openai/gpt-4o-mini
# Fallbacks if you leave the xAI default names in place:
# ASDA_OPENROUTER_MODEL_FRONTIER=anthropic/claude-sonnet-4
# ASDA_OPENROUTER_MODEL_FAST=openai/gpt-4o-mini

# SpaceXAI / xAI (optional — used when ASDA_LLM_PROVIDER=xai)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# ASDA_MODEL_FRONTIER=grok-4.6
# ASDA_MODEL_FAST=grok-4.3

# ── App ───────────────────────────────────────────────────────
ASDA_ENV=dev
ASDA_LOG_LEVEL=INFO
ASDA_DATA_DIR=./data
ASDA_MIN_SCORE=55
ASDA_DRY_RUN=true

# ── Database (SQLite by default; swap for Postgres in prod) ───
DATABASE_URL=sqlite:///./data/asda.db

# ── Redis (optional — in-process bus used if empty) ───────────
REDIS_URL=

# ── Human-in-the-loop (comma-separated stages) ────────────────
# Stages: research, content, outreach, reply, handoff
ASDA_HITL_STAGES=reply,outreach

# ── Lead sources ──────────────────────────────────────────────
APOLLO_API_KEY=
# Free authenticates; People Search needs a paid plan. Do not buy unless you want
# Apollo people ingest — CSV upload is enough for the rest of the agent.
SIGNALHIRE_API_KEY=
GOOGLE_SHEETS_CREDENTIALS_JSON=

# ── Outreach ──────────────────────────────────────────────────
# Instantly — preferred mail (Google Workspace + Outlook OAuth, warmup, inbox)
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_SESSION_COOKIE=

# Bolna (phone). Last channel after email and LinkedIn go quiet.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=

# ── CRM / Calendar / Notify ───────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
SLACK_WEBHOOK_URL=

# ── Safety ────────────────────────────────────────────────────
ASDA_EMAIL_DAILY_CAP=80
ASDA_LINKEDIN_DAILY_CAP=15
ASDA_LINKEDIN_CONNECT_DAILY_CAP=8
ASDA_LINKEDIN_CONNECT_WEEKLY_CAP=40
